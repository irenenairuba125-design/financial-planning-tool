# Copy this file to .env and fill in your own values.
# Leave a section empty and that alert channel runs in "dry run" mode (printed to the console only).

PORT=3000
# Set to 1 when the site is served over HTTPS (required when online)
COOKIE_SECURE=0
# How often to check every user's plan for new alerts
ALERT_CHECK_MINUTES=60
# Used to turn 0772123456 into +256772123456
DEFAULT_COUNTRY_CODE=256

# --- Email alerts (any SMTP provider, e.g. Gmail app password, Brevo, Mailgun) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# --- SMS alerts (Africa's Talking). Use AT_USERNAME=sandbox to test for free ---
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
